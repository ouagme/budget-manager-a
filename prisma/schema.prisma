generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum Role { USER ADMIN }
enum AccountType { CASH BANK CREDIT_CARD SAVINGS DIGITAL_WALLET INVESTMENT }
enum TransactionType { INCOME EXPENSE TRANSFER }
model User { id String @id @default(cuid()); name String?; email String @unique; passwordHash String?; role Role @default(USER); defaultCurrency String @default("MAD"); locale String @default("fr"); accounts Account[]; transactions Transaction[]; budgets Budget[]; savingsGoals SavingsGoal[]; categories Category[]; recurring RecurringTransaction[]; notifications Notification[]; tags Tag[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Currency { code String @id; symbol String; decimals Int @default(2); active Boolean @default(true); rates ExchangeRate[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ExchangeRate { id String @id @default(cuid()); baseCode String; quoteCode String; rate Decimal @db.Decimal(24,12); rateDate DateTime; source String @default("manual"); base Currency @relation(fields:[baseCode],references:[code]); @@index([baseCode,quoteCode,rateDate]) }
model Account { id String @id @default(cuid()); userId String; name String; type AccountType; currencyCode String; initialBalance Decimal @db.Decimal(20,6); institution String?; notes String?; active Boolean @default(true); user User @relation(fields:[userId],references:[id],onDelete:Cascade); currency Currency @relation(fields:[currencyCode],references:[code]); transactions Transaction[]; @@index([userId,active]) }
model Category { id String @id @default(cuid()); userId String?; name String; kind TransactionType; icon String?; color String?; user User? @relation(fields:[userId],references:[id],onDelete:Cascade); transactions Transaction[]; @@index([userId,kind]) }
model Transaction { id String @id @default(cuid()); userId String; accountId String; categoryId String?; type TransactionType; amount Decimal @db.Decimal(20,6); currencyCode String; reportingAmount Decimal? @db.Decimal(20,6); reportingCurrency String?; exchangeRate Decimal? @db.Decimal(24,12); date DateTime; description String?; paymentMethod String?; notes String?; user User @relation(fields:[userId],references:[id],onDelete:Cascade); account Account @relation(fields:[accountId],references:[id],onDelete:Cascade); category Category? @relation(fields:[categoryId],references:[id],onDelete:SetNull); @@index([userId,date]); @@index([accountId,date]); @@index([currencyCode,date]) }
model Budget { id String @id @default(cuid()); userId String; name String; month DateTime; amount Decimal @db.Decimal(20,6); currencyCode String; categoryId String?; rollover Boolean @default(false); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,month]) }
model SavingsGoal { id String @id @default(cuid()); userId String; name String; targetAmount Decimal @db.Decimal(20,6); currentAmount Decimal @db.Decimal(20,6) @default(0); currencyCode String; deadline DateTime?; description String?; user User @relation(fields:[userId],references:[id],onDelete:Cascade) }
model RecurringTransaction { id String @id @default(cuid()); userId String; description String; type TransactionType; amount Decimal @db.Decimal(20,6); currencyCode String; frequency String; nextRun DateTime; active Boolean @default(true); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,nextRun]) }
model Transfer { id String @id @default(cuid()); userId String; fromAccountId String; toAccountId String; fromAmount Decimal @db.Decimal(20,6); toAmount Decimal @db.Decimal(20,6); fromCurrency String; toCurrency String; exchangeRate Decimal? @db.Decimal(24,12); fee Decimal @db.Decimal(20,6) @default(0); feeCurrency String; date DateTime; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,date]) }
model Notification { id String @id @default(cuid()); userId String; type String; title String; message String; read Boolean @default(false); createdAt DateTime @default(now()); user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@index([userId,read,createdAt]) }
model Tag { id String @id @default(cuid()); userId String; name String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); @@unique([userId,name]) }
model Attachment { id String @id @default(cuid()); transactionId String; url String; name String; mimeType String?; size Int?; transaction Transaction @relation(fields:[transactionId],references:[id],onDelete:Cascade) }
